# Copy this file to .env for local development. Never commit .env or real secrets.

# Application
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./live_data_intelligence.db

# LLM provider (optional in demo mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Integrations (optional; mock/demo adapters work without credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
NOTION_API_KEY=

# Frontend/backend local development
BACKEND_PORT=8000
VITE_API_BASE_URL=http://localhost:8000
