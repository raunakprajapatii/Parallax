# Copy this file to .env for local development. Never commit .env or real secrets.

# Application
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./live_data_intelligence.db

# LLM provider: choose "gemini" or "groq". Without a key, extractive answers are used.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Integrations (optional; mock/demo adapters work without credentials)
GMAIL_ACCESS_TOKEN=
GMAIL_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/gmail/callback
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/calendar/callback
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
NOTION_API_KEY=
NOTION_VERSION=2022-06-28
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/jira/callback
JIRA_OAUTH_SCOPES=read:jira-work read:jira-user offline_access
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/notion/callback
CONNECTOR_ENABLE_LIVE=false
CONNECTOR_DEMO_MODE=true

# Frontend/backend local development
BACKEND_PORT=8000
VITE_API_BASE_URL=http://localhost:8000
VITE_CONNECTOR_DEMO_MODE=true
